# Calculate access time from the live entitlement on every authentication.
# radreply.Session-Timeout is only a snapshot written when a package is issued
# or extended; FreeRADIUS does not decrement that SQL value as time passes.
# WiFi usernames have an entitlement row; PPPoE and other RADIUS users do not.
captyn_session_expiry {
	if (&User-Name) {
		update control {
			&Tmp-Integer-0 := "%{sql:SELECT CASE WHEN COUNT(*) = 0 THEN -1 ELSE COALESCE(MAX(CASE WHEN status = 'active' AND \"expiresAt\" > NOW() AND \"outagePausedAt\" IS NULL AND \"promoPausedAt\" IS NULL THEN FLOOR(EXTRACT(EPOCH FROM (\"expiresAt\" - NOW())))::bigint END), 0) END FROM \"WifiEntitlement\" WHERE username = '%{SQL-User-Name}'}"
		}
		if (&control:Tmp-Integer-0 >= 0) {
			if (&control:Tmp-Integer-0 <= 0) {
				update reply {
					&Reply-Message := "This WiFi package has expired or is paused. Please reconnect after restoring access."
				}
				reject
			}
			update reply {
				&Session-Timeout := &control:Tmp-Integer-0
			}
		}
	}
}

# CAPTYN device ledger and switch cap (see the wifi_device_ledger migration).

# authorize: turn away a new device once the package has used its allowance
# of different devices. Devices already used on the package always get in.
captyn_device_cap {
	if (&User-Name && &Calling-Station-Id) {
		if ("%{sql:SELECT captyn_device_over_cap('%{User-Name}', '%{Calling-Station-Id}')}" == "1") {
			update reply {
				&Reply-Message := "This package has reached its device limit. Use a device you've signed in with before, or buy a new package."
			}
			reject
		}
	}
}

# post-auth (accepted logins only): record the device against the package.
captyn_record_device {
	if (&User-Name && &Calling-Station-Id) {
		update control {
			&Tmp-String-0 := "%{sql:SELECT captyn_record_device('%{User-Name}', '%{Calling-Station-Id}')}"
		}
	}
}
