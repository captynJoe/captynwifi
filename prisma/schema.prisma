generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WifiPaymentIntentStatus {
  pending_confirmation
  confirmed
  failed
  paid_pending_activation
  activated
}

enum WifiEntitlementStatus {
  pending_activation
  active
  expired
  suspended
  revoked
}

enum WifiProjectionStatus {
  pending
  applied
  failed
}

model WifiSite {
  id          String       @id
  name        String
  source      String       @default("captyn_housing")
  externalId  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  plans       WifiPlan[]
  intents     WifiPaymentIntent[]
  entitlements WifiEntitlement[]
  promos      WifiPromo[]

  @@unique([source, externalId])
  @@index([source])
}

model WifiPlan {
  id                String       @id @default(uuid())
  siteId            String
  source            String       @default("captyn_housing")
  externalPackageId String
  name              String
  durationSeconds   Int
  priceKsh          Int
  category          String       @default("standard")
  rateLimit         String?
  deviceLimit       Int          @default(1)
  enabled           Boolean      @default(true)
  featured          Boolean      @default(false)
  manualPricing     Boolean      @default(false)
  imageFile         String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  site              WifiSite     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  intents           WifiPaymentIntent[]
  entitlements      WifiEntitlement[]

  @@unique([siteId, source, externalPackageId])
  @@index([siteId, enabled])
  @@index([siteId, category, enabled])
}

model WifiPaymentIntent {
  id                  String                  @id @default(uuid())
  siteId              String
  planId              String
  source              String                  @default("captyn_housing")
  sourceReference     String
  customerPhone       String
  deviceMac           String?
  amountKsh           Int
  provider            String                  @default("mpesa")
  providerReference   String?
  receiptNumber       String?
  status              WifiPaymentIntentStatus @default(pending_confirmation)
  rawPayload          Json?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  confirmedAt         DateTime?
  site                WifiSite                @relation(fields: [siteId], references: [id], onDelete: Cascade)
  plan                WifiPlan                @relation(fields: [planId], references: [id], onDelete: Restrict)
  entitlement         WifiEntitlement?

  @@unique([source, sourceReference])
  @@index([siteId, status, createdAt])
  @@index([provider, providerReference])
  @@index([receiptNumber])
}

model WifiEntitlement {
  id               String                @id @default(uuid())
  siteId           String
  planId           String
  paymentIntentId  String                @unique
  customerPhone    String
  username         String
  cleartextSecret  String
  deviceMac        String?
  status           WifiEntitlementStatus @default(pending_activation)
  startsAt         DateTime
  expiresAt        DateTime
  deviceLimit      Int                   @default(1)
  rateLimit        String?
  acctInterimSeconds Int                 @default(120)
  outagePausedAt   DateTime?
  outagePauseCause String?
  promoPausedAt    DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  site             WifiSite              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  plan             WifiPlan              @relation(fields: [planId], references: [id], onDelete: Restrict)
  paymentIntent    WifiPaymentIntent     @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)
  projection       WifiRadiusProjection?

  @@index([siteId, status, expiresAt])
  @@index([username])
  @@index([deviceMac, status, expiresAt])
  @@index([outagePausedAt])
  @@index([promoPausedAt])
}

// A time-boxed free-access campaign an admin can launch: everyone who hits
// the portal gets free access until `endsAt` instead of the normal purchase
// flow, and (if pauseExisting) every currently-active paid entitlement's
// clock freezes for the duration -- same "credit the frozen time back" idea
// as outage pausing, but tracked on separate fields (promoPausedAt, not
// outagePausedAt) since this is a deliberate admin action, not an incident,
// and must never be conflated with outage-credit accounting/analytics.
model WifiPromo {
  id            String   @id @default(uuid())
  siteId        String
  active        Boolean  @default(false)
  heading       String?
  message       String?
  endsAt        DateTime
  rateLimit     String?
  deviceLimit   Int      @default(1)
  pauseExisting Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  site          WifiSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([active])
}

model WifiRadiusProjection {
  id              String                @id @default(uuid())
  entitlementId   String                @unique
  status          WifiProjectionStatus  @default(pending)
  username        String
  checkItems      Json
  replyItems      Json
  lastError       String?
  appliedAt       DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  entitlement     WifiEntitlement       @relation(fields: [entitlementId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
  @@index([username])
}

model WifiAccountingSession {
  id                    String    @id @default(uuid())
  acctSessionId          String
  username              String
  entitlementClass       String?
  callingStationId       String?
  calledStationId        String?
  nasIpAddress           String?
  nasIdentifier          String?
  framedIpAddress        String?
  acctSessionTimeSeconds Int?
  inputOctets            BigInt?
  outputOctets           BigInt?
  terminateCause         String?
  startedAt              DateTime?
  stoppedAt              DateTime?
  lastInterimAt          DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([acctSessionId, username])
  @@index([username])
  @@index([nasIdentifier])
  @@index([lastInterimAt])
}

model WifiGovernorEvent {
  id                 String   @id @default(uuid())
  state              String
  dryRun             Boolean  @default(true)
  activeSessionCount Int      @default(0)
  activeDemandMbps   Float    @default(0)
  utilizationScore   Float    @default(0)
  username           String?
  entitlementId      String?
  previousRateLimit  String?
  targetRateLimit    String?
  reason             String
  raw                Json?
  createdAt          DateTime @default(now())

  @@index([createdAt])
  @@index([state, createdAt])
  @@index([username, createdAt])
}

model WifiDynamicPlanEvent {
  id                   String   @id @default(uuid())
  siteId               String
  state                String
  dryRun               Boolean  @default(true)
  avgUtilizationScore  Float    @default(0)
  sampleCount          Int      @default(0)
  windowStartsAt       DateTime
  windowEndsAt         DateTime
  planId               String?
  durationSeconds      Int?
  priceKsh             Int?
  rateLimit            String?
  published            Boolean  @default(false)
  createdAt            DateTime @default(now())

  @@index([siteId, createdAt])
}


model WifiServiceHeartbeat {
  service    String   @id
  lastSeenAt DateTime
  updatedAt  DateTime @default(now()) @updatedAt
}

model WifiOutageCredit {
  id                   String   @id @default(uuid())
  service              String
  outageStartedAt      DateTime
  outageEndedAt        DateTime
  creditedSeconds      Int
  affectedEntitlements Int      @default(0)
  entitlementId        String?
  createdAt            DateTime @default(now())

  @@unique([service, outageStartedAt, outageEndedAt])
  @@index([service, createdAt])
  @@index([outageStartedAt, outageEndedAt])
  @@index([entitlementId])
}
