{
  "name": "captyn-wifi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/server.ts",
    "build": "npm run build:portal && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.portal.json",
    "test": "NODE_ENV=test node --import tsx --test tests/*.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "radius:worker": "node dist/workers/radiusSqlWorker.js",
    "build:portal": "tsc -p tsconfig.portal.json",
    "governor:worker": "node dist/workers/dynamicGovernorWorker.js"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "@types/speakeasy": "^2.0.10",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "speakeasy": "^2.0.0",
    "zod": "^3.24.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "prisma": "^6.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
